# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# Airflow web UI admin login
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# AWS credentials for the profile_source_data Airflow task, which reads
# directly from S3 via pandas/s3fs. Separate from Snowflake's own
# Storage Integration (Snowflake handles its own S3 access internally).
#
# IAM user should be scoped to read-only (s3:GetObject, s3:ListBucket)
# on the specific bucket only.
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DEFAULT_REGION=ap-south-1